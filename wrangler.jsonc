{
  // Cloudflare Workers Builds deploys this repo as a static site: the Worker named "games"
  // serves the repo root as assets. There is no Worker script and no build step.
  // Files listed in .assetsignore are left out of the upload.
  "name": "games",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
